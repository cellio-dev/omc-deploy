# Minimum .env: set DB_PASSWORD only. Everything else has a compose default.
# Use letters and numbers only. This value is embedded in the database URL.
DB_PASSWORD=change-this-database-password

# The admin console listens on all interfaces by default. Never forward this
# port from the internet. To restrict it to one interface, set
# WEB_PUBLISH=<lan-ip>:8443:8443.
# Default: 0.0.0.0:8443:8443
# WEB_PUBLISH=0.0.0.0:8443:8443

# Public enrollment portal. Forward router TCP 443 here only.
# Default: 0.0.0.0:443:8444
# PORTAL_PUBLISH=0.0.0.0:443:8444

# Shared secret between portal and app (compose network only). Leave unset so the
# app auto-generates one on first start and writes it to the portal-tls volume
# (api.secret) for the portal to read. Set explicitly only for multi-host installs:
#   openssl rand -hex 32
# PORTAL_API_SECRET=

# Optional: pin the public hostname for portal SNI/Host checks.
# Overrides the Public hostname saved on Settings → Enrollment portal.
# PORTAL_HOSTNAME=vpn.example.com

# Must match the port and protocol saved in the VPN page.
# Default: 1194:1194/udp
# VPN_PUBLISH=1194:1194/udp

# Host directory for scheduled local backups (mounted at /backups in the app).
# Default: ./backups (relative to the compose project). The app user is uid 10001;
# after creating a custom folder run:
#   sudo mkdir -p /opt/omc/backups && sudo chown 10001:10001 /opt/omc/backups
# BACKUP_DIR=./backups

# Host port used in the HTTP-to-HTTPS redirect. Leave unset to use the host port
# from WEB_PUBLISH (8443 by default, so the redirect is https://hostname:8443/).
# WEB_PUBLIC_PORT=443

# Let's Encrypt HTTP-01 challenge listener (app container port 8080). Forward
# public TCP 80 to this host mapping and leave it open for renewals (~60 days).
# WEB_PUBLISH must never be forwarded. Default: 0.0.0.0:80:8080
# If the host cannot bind port 80, remap (for example 127.0.0.1:8080:8080).
ACME_PUBLISH=0.0.0.0:80:8080

# Image checked for OMC updates. The tag list is read from this registry; nothing about this install is sent.
# OMC_IMAGE=ghcr.io/cellio-dev/omc-app
